pragma solidity ^0.8.20;

contract JPHANAToken {
    
    string public constant name = "JPHANA USD";
    string public constant symbol = "JPAUS";
    uint8 public constant decimals = 6; // Perfect 1:1 alignment with native USDC
    
    uint256 public totalSupply;
    address public immutable engine;
    address public owner;

    mapping(address => uint256) public balanceOf;
    mapping(address => mapping(address => uint256)) public allowance;

    event Transfer(address indexed from, address indexed to, uint256 value);
    event Approval(address indexed owner, address indexed spender, uint256 value);

    modifier onlyEngine() {
        require(msg.sender == engine, "DB Precepts: Authorized execution through Engine only");
        _;
    }

    constructor(address _engine) {
        require(_engine != address(0), "Invalid engine layout");
        engine = _engine;
        owner = msg.sender;
    }

    // =========================================================================
    // DB PRECEPTS: STRICT CLOSED-LOOP TRANSFER LOCKDOWN
    // =========================================================================

    /**
     * @notice Open transfers are permanently disabled to prevent external pool seeding.
     */
    function transfer(address /* to */, uint256 /* value */) external pure returns (bool) {
        revert("DB Precepts: Secondary market exchanges strictly prohibited");
    }

    /**
     * @notice External multi-party approvals are permanently disabled.
     */
    function transferFrom(address /* from */, address /* to */, uint256 /* value */) external pure returns (bool) {
        revert("DB Precepts: Secondary market exchanges strictly prohibited");
    }

    function approve(address /* spender */, uint256 /* value */) external pure returns (bool) {
        revert("DB Precepts: External platform approvals disabled");
    }

    // =========================================================================
    // ENGINE MANDATED LIQUIDITY LIFECYCLES
    // =========================================================================

    function mint(address _to, uint256 _amount) external onlyEngine {
        totalSupply += _amount;
        balanceOf[_to] += _amount;
        emit Transfer(address(0), _to, _amount);
    }

    function burn(address _from, uint256 _amount) external onlyEngine {
        require(balanceOf[_from] >= _amount, "DB Precepts: Burning exceeds balance");
        totalSupply -= _amount;
        balanceOf[_from] -= _amount;
        emit Transfer(_from, address(0), _amount);
    }
}
